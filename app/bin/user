#!/usr/bin/env python3
"""Manage CardDAV users and their M365 mailboxes.

  user list
  user add <name> <mailbox> [--no-password] [--password] [--no-check] [--hours N]
  user del <name> [--yes]
  user passwd <name>     set the password yourself (admin)
  user invite <name> [--hours N]
                         one-time link for the user to choose the password
                         (needs ENROLLMENT=true or ADMIN_UI=true)
  user sync              run a sync round now (all users)
  user resync <name>     next round is a full resync for this user

Run inside the container:  docker exec -it m365-carddav user <command>
Changes take effect without a restart.
"""
import argparse
import getpass
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from common import (carddav_url, env_bool, env_int, load_users, read_htpasswd,  # noqa: E402
                    set_htpasswd, trigger_sync)
import userops  # noqa: E402


def web_enabled():
    return env_bool("ENROLLMENT", False) or env_bool("ADMIN_UI", False)


def print_invite(user, hours):
    inv = userops.new_invite(user, hours)
    bar = "-" * 72
    print(f"\nOne-time link for '{user}' (valid until {inv['expires']}, shown only now):\n\n"
          f"  {inv['url']}\n")
    print("Text to send:\n" + bar)
    print(inv["text"].rstrip())
    print(bar)
    if not web_enabled():
        print("WARNING: the link only works with -e ENROLLMENT=true and -p 5233:5233.")


def ask_password(user):
    pw = getpass.getpass(f"New CardDAV password for '{user}': ")
    if len(pw) < 12:
        sys.exit("At least 12 characters.")
    if pw != getpass.getpass("Repeat: "):
        sys.exit("Passwords do not match.")
    set_htpasswd(user, pw)
    print(f"Password for '{user}' set.")


def need_user(name):
    if name not in load_users():
        sys.exit(f"Unknown user '{name}'.")


def cmd_list(_):
    rows = userops.user_rows()
    if not rows:
        print("No users configured.")
        return
    table = [("USER", "MAILBOX", "PASSWORD", "LAST SYNC", "STATUS")]
    for r in rows:
        pw = ("yes" if r["password"] else "MISSING") + (
            f", invite until {r['invite_until']}" if r["invite_until"] else "")
        status = ("ERROR: " + r["status"][:70]) if r["error"] else r["status"]
        table.append((r["name"], r["mailbox"], pw, r["last_sync"] or "-", status))
    widths = [max(len(row[i]) for row in table) for i in range(4)]
    for row in table:
        print("  ".join(row[i].ljust(widths[i]) for i in range(4)) + "  " + row[4])


def cmd_add(a):
    try:
        name, mailbox = userops.validate_new_user(a.name, a.mailbox)
    except ValueError as e:
        sys.exit(str(e))
    taken = [u for u, c in load_users().items() if c["mailbox"].lower() == mailbox.lower()]
    if taken:
        print(f"Note: mailbox is already mapped to '{taken[0]}'.")
    if not a.no_check:
        ok, msg = userops.check_access(mailbox)
        print({True: "OK: ", False: "WARNING: ", None: ""}[ok] + msg)
    userops.add_user(name, mailbox)
    print(f"User '{name}' -> {mailbox} added. Sync triggered.")
    print(f"CardDAV URL: {carddav_url(name)}")
    if a.no_password:
        return
    if web_enabled() and not a.password:
        print_invite(name, a.hours)
    else:
        ask_password(name)


def cmd_del(a):
    need_user(a.name)
    if not a.yes:
        mailbox = load_users()[a.name]["mailbox"]
        answer = input(f"Delete '{a.name}' ({mailbox}) incl. its address book? [y/N] ")
        if answer.strip().lower() not in ("y", "yes"):
            sys.exit("Aborted.")
    userops.delete_user(a.name)
    print(f"User '{a.name}' deleted. Mailbox access in Exchange is unchanged "
          f"(remove the mailbox from the scope group if it should lose access).")


def cmd_passwd(a):
    need_user(a.name)
    ask_password(a.name)


def cmd_invite(a):
    need_user(a.name)
    print_invite(a.name, a.hours)
    if a.name in read_htpasswd():
        print("The current password stays valid until the user sets a new one.")


def cmd_sync(_):
    trigger_sync()
    print("Sync round triggered (see docker logs).")


def cmd_resync(a):
    need_user(a.name)
    userops.resync_user(a.name)
    print(f"Full resync of '{a.name}' triggered.")


def main():
    hours = env_int("ENROLLMENT_HOURS", 72)
    p = argparse.ArgumentParser(prog="user", description="Manage CardDAV users / M365 mailboxes.")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="list users and sync status").set_defaults(fn=cmd_list)
    s = sub.add_parser("add", help="add a user")
    s.add_argument("name", help="CardDAV login name (a-z 0-9 . _ -)")
    s.add_argument("mailbox", help="M365 mailbox (primary SMTP address)")
    s.add_argument("--no-password", action="store_true", help="no password / invitation now")
    s.add_argument("--password", action="store_true",
                   help="set the password yourself even if invitations are enabled")
    s.add_argument("--no-check", action="store_true", help="skip the Graph access check")
    s.add_argument("--hours", type=int, default=hours, help="validity of the invitation link")
    s.set_defaults(fn=cmd_add)
    s = sub.add_parser("del", help="delete a user and its address book")
    s.add_argument("name")
    s.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    s.set_defaults(fn=cmd_del)
    s = sub.add_parser("passwd", help="set a user's CardDAV password")
    s.add_argument("name")
    s.set_defaults(fn=cmd_passwd)
    s = sub.add_parser("invite", help="one-time link for the user to set the password")
    s.add_argument("name")
    s.add_argument("--hours", type=int, default=hours)
    s.set_defaults(fn=cmd_invite)
    sub.add_parser("sync", help="run a sync round now").set_defaults(fn=cmd_sync)
    s = sub.add_parser("resync", help="force a full resync of one user")
    s.add_argument("name")
    s.set_defaults(fn=cmd_resync)
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
