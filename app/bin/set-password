#!/usr/bin/env python3
"""Sets the CardDAV password for the read-only user (default: CARDDAV_USER)."""
import getpass
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from common import CARDDAV_USER, SYNC_USER, set_htpasswd

user = sys.argv[1] if len(sys.argv) > 1 else CARDDAV_USER
if user == SYNC_USER:
    sys.exit("The internal sync user is managed automatically.")
pw = getpass.getpass(f"New password for '{user}': ")
if len(pw) < 12:
    sys.exit("At least 12 characters.")
if pw != getpass.getpass("Repeat: "):
    sys.exit("Passwords do not match.")
set_htpasswd(user, pw)
print(f"Password for '{user}' set.")
