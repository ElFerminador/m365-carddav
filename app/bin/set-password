#!/usr/bin/env python3
"""Kept for compatibility with 1.x - same as `user passwd <name>`.

Without an argument: CARDDAV_USER from the environment, or the only configured user.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from common import load_users  # noqa: E402

users = load_users()
if len(sys.argv) > 1:
    name = sys.argv[1]
elif os.environ.get("CARDDAV_USER"):
    name = os.environ["CARDDAV_USER"].strip()
elif len(users) == 1:
    name = next(iter(users))
else:
    sys.exit("Usage: set-password <user>   (or: user passwd <user>)")
os.execvp("user", ["user", "passwd", name])
